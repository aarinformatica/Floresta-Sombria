<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Floresta Sombria - Horror 3D</title>
  <link rel="stylesheet" href="style.css">
  <!-- Three.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

  <!-- UI Overlay -->
  <div id="ui-container">
    <!-- Stamina Bar -->
    <div id="stamina-container">
      <div id="stamina-label">ENERGIA</div>
      <div id="stamina-bar-bg"><div id="stamina-bar"></div></div>
    </div>
    
    <!-- Items Counter -->
    <div id="pages-counter">
      <span id="pages-icon">📜</span> Paginas Encontradas: <span id="pages-count">0</span> / <span id="pages-total">5</span>
    </div>

    <!-- Battery Counter / Flashlight Status -->
    <div id="battery-container">
      <span id="battery-icon">🕯️</span> Óleo da Lanterna: <span id="battery-level">100%</span>
    </div>

    <!-- Message Log / Subtitles -->
    <div id="message-log"></div>
  </div>

  <!-- Mira no centro -->
  <div id="crosshair"></div>

  <!-- Tela Inicial / Pausa -->
  <div id="instructions">
    <div class="menu-box">
      <h1>O RITUAL DA FLORESTA</h1>
      <p class="subtitle">Encontre as 5 páginas antigas para quebrar a maldição antes que a luz acabe ou ALGO o pegue.</p>
      
      <div class="controls-guide">
        <div class="control-item"><span>WASD</span> Mover</div>
        <div class="control-item"><span>SHIFT</span> Correr</div>
        <div class="control-item"><span>F</span> Ligar / Desligar Lanterna</div>
        <div class="control-item"><span>E</span> Interagir / Pegar Página</div>
        <div class="control-item"><span>MOUSE</span> Olhar ao redor</div>
      </div>

      <button id="start-btn">ENTRAR NA FLORESTA</button>
    </div>
  </div>

  <!-- Overlay de Morte / Vitoria -->
  <div id="game-over-overlay" class="hidden">
    <div class="menu-box">
      <h1 id="game-over-title">VOCÊ FOI CONSUMIDO</h1>
      <p id="game-over-text">A escuridão tomou sua alma...</p>
      <button id="restart-btn">TENTAR NOVAMENTE</button>
    </div>
  </div>

  <script src="script.js"></script>
</body>
</html>
